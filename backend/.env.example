# copia este archivo como .env y completa los valores

# Django
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
DEBUG=True                          # True en local, False en producción

# Base de datos PostgreSQL
DB_NAME=faraelectronica
DB_USER=postgres
DB_PASSWORD=tu-password
DB_HOST=localhost
DB_PORT=5432

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH2_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=tu-client-secret

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Transbank / Webpay
# con DEBUG=True no hace falta, el SDK usa las credenciales de prueba
# en producción (Render) van las credenciales reales
TBK_COMMERCE_CODE=
TBK_API_KEY=
WEBPAY_RETURN_URL=http://localhost:5173/pago/retorno
# En producción: https://faraelectronica.vercel.app/pago/retorno

# Tienda (lo que se muestra en el front sale de acá, así se cobra lo mismo)
# combos globales cantidad:%descuento (vacío = solo los precios escalonados del admin)
COMBO_DESCUENTOS=
# suscríbete y ahorra (0 = apagado) y frecuencias en días
SUSCRIPCION_DESCUENTO_PCT=10
SUSCRIPCION_FRECUENCIAS=30,60,90
# envío gratis desde este total (0 = sin barra)
ENVIO_GRATIS_DESDE=50000
# url pública del front (links de los correos de recompra)
FRONTEND_URL=http://localhost:5173

# Meta Conversions API (vacío = no se envía nada)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v26.0

# Klaviyo private key (eventos del recordatorio de suscripción)
KLAVIYO_PRIVATE_KEY=
