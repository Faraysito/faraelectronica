# ─────────────────────────────────────────────────────────────────
#  Variables de entorno del FRONTEND — Fara Electrónica
#  Copia este archivo como `.env` y completa los valores.
#  En Vite, las variables deben empezar con VITE_ para ser accesibles.
#  Colocar en: frontend/.env.example
# ─────────────────────────────────────────────────────────────────

# URL del backend. En local apunta a Django; en producción a Render.
VITE_API_URL=http://localhost:8000
# Producción: https://faraelectronica-backend.onrender.com

# Google OAuth — el mismo Client ID configurado en Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
