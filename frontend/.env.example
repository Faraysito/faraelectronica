# copia este archivo como .env

# URL del backend. En local apunta a Django; en producción a Render.
VITE_API_URL=http://localhost:8000
# Producción: https://faraelectronica-backend.onrender.com

# Google OAuth (el mismo Client ID de Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Meta Pixel (vacío = no se carga)
VITE_META_PIXEL_ID=

# Klaviyo pop-up de email: public key (site id) + id de la lista (vacío = no aparece)
VITE_KLAVIYO_PUBLIC_KEY=
VITE_KLAVIYO_LIST_ID=
